# Copiar como .env únicamente en el servidor. No subir credenciales reales.
NODE_ENV=production
PORT=3000
FRONTEND_URL=https://farmacom.website
TRUST_PROXY_HOPS=1

# Estas dos variables se incorporan al bundle durante docker compose build.
VITE_API_URL=/api
VITE_LECTOR_TUNEL_PRIVADO=false

POSTGRES_DB=farmacom
POSTGRES_USER=farmacom
POSTGRES_PASSWORD=<generar-una-clave-segura>
DB_PORT=5432

JWT_SECRET=<generar-un-secreto-aleatorio-largo>
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=12

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=farmacom.reportes@gmail.com
SMTP_PASSWORD=<contraseña-de-aplicación-de-google>
CORREO_REMITENTE=FarmaCom <farmacom.reportes@gmail.com>

# Configurar sólo si se utiliza el cobro con Recurrente.
RECURRENTE_TERMINAL_ID=
RECURRENTE_WEBHOOK_SECRET=
RECURRENTE_SECRET_KEY=
