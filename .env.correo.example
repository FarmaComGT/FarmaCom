# Backend fuera de Docker; buzón de pruebas en http://localhost:8025
# Agregar estas variables al .env local, sin subir credenciales.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_USER=
SMTP_PASSWORD=
CORREO_REMITENTE=FarmaCom <reportes@farmacom.test>

# Para un proveedor real: host y credenciales SMTP del proveedor.
# Puerto 587: SMTP_SECURE=false y SMTP_REQUIRE_TLS=true.
# Puerto 465: SMTP_SECURE=true. En producción se exige TLS.
