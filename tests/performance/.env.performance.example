# URL de la API vista desde el contenedor de k6.
K6_API_URL=http://backend:3000/api

# Usuario ficticio con acceso a la sucursal indicada.
K6_USER_EMAIL=usuario.pruebas@farmacom.test
K6_USER_PASSWORD=reemplazar_con_clave_local
K6_BRANCH_ID=1
K6_BRANCH_IDS=1,2,3

# Distribución de los seis usuarios de la prueba de carga.
K6_LOAD_POS_VUS=3
K6_LOAD_MANAGEMENT_VUS=2
K6_LOAD_REPORTS_VUS=1

# Duración total predeterminada: cinco minutos.
K6_LOAD_RAMP_UP=30s
K6_LOAD_STEADY_DURATION=4m
K6_LOAD_RAMP_DOWN=30s

# Fechas opcionales para las consultas del dashboard (YYYY-MM-DD).
# Si se omiten, k6 utiliza los últimos 30 días.
K6_REPORT_DATE_FROM=
K6_REPORT_DATE_TO=

# Prueba de estrés: incremento hasta 20 usuarios y recuperación con 3.
K6_STRESS_MAX_VUS=20
K6_STRESS_RECOVERY_VUS=3
K6_STRESS_WARM_UP=15s
K6_STRESS_STAGE_DURATION=30s
K6_STRESS_RECOVERY_DURATION=1m
K6_STRESS_COOL_DOWN=15s

# Ventas controladas. Permanecen deshabilitadas hasta preparar datos locales.
# Cada par representa una caja virtual con el formato id_sucursal:id_lote.
K6_TARGET_ENV=local
K6_ALLOW_WRITES=false
K6_SALES_CASES=1:5,2:6,3:7
K6_SALES_QUANTITY=1
K6_SALES_ITERATIONS_PER_VU=3
K6_SALES_MAX_DURATION=2m
K6_SALES_THINK_TIME=1
K6_REPORT_REFRESH_TIMEOUT_SECONDS=20
K6_REPORT_POLL_INTERVAL=0.25
