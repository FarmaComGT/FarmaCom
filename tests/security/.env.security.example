# Este archivo no contiene secretos. La autenticación se agregará en un
# incremento posterior mediante credenciales ficticias exclusivas para pruebas.

# El ejecutor bloquea cualquier valor diferente de local.
ZAP_TARGET_ENV=local

# URL que puede resolver el contenedor de ZAP dentro de Docker Compose.
ZAP_TARGET_URL=http://backend:3000

# Ruta relativa dentro de tests/security.
ZAP_PLAN=plans/smoke.yaml

# Administrador ficticio para el plan authenticated-read.yaml. Déjalos vacíos
# para la prueba de humo y configúralos únicamente en .env.security.
ZAP_ADMIN_EMAIL=
ZAP_ADMIN_PASSWORD=
